# =============================================================================
# Python 主后端（FastAPI）— 开发环境配置示例
# 复制为 .env 后修改实际值
# =============================================================================

# 环境
ENVIRONMENT=development
DEBUG=true
SITE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# 数据库（开发默认 SQLite；生产使用 PostgreSQL）
DB_TYPE=sqlite
DATABASE_URL=sqlite:///./youding_dev.db

# Redis（开发可选）
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# MinIO 文件存储
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# JWT — 生产环境必须配置长度 ≥32 的强随机值
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# AI 服务（至少配置一个即可使用）
AI_OPENAI_API_KEY=
# 讯飞语音转写 · 录音文件转写大模型（控制台三件套 → 下方三个变量）
# 文档：https://www.xfyun.cn/doc/spark/asr_llm/Ifasr_llm.html
XFYUN_LFASR_APP_ID=
XFYUN_LFASR_API_KEY=
XFYUN_LFASR_SECRET_KEY=
# XFYUN_LFASR_BASE_URL=https://office-api-ist-dx.iflyaisol.com
# XFYUN_LFASR_LANGUAGE=autodialect
# 旧版 raasr 仍可用：XFYUN_LFASR_BASE_URL=https://raasr.xfyun.cn/api 且留空 API_KEY
# XFYUN_LFASR_PREFERRED=0 本地 Whisper 优先；配齐 APP_ID+SECRET 默认讯飞整段直传
# XFYUN_LFASR_ENABLED=0 可显式关闭
# XFYUN_LFASR_POLL_INTERVAL_SEC=5
# XFYUN_LFASR_MAX_WAIT_SEC=1800
# Gemini 音频听写兜底（复用 AI_GEMINI_API_KEY，前序 ASR 均失败时使用）
AI_GEMINI_API_KEY=
# AI_GEMINI_ASR_MODEL=gemini-2.0-flash
# AI_GEMINI_ASR_ENABLED=0 可显式关闭
AI_ANTHROPIC_API_KEY=
AI_GEMINI_API_KEY=
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_NVIDIA_API_KEY=
AI_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AI_NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# 翻译真源（P1-1）：OpenAI 兼容 LLM 机翻端点。未配置时 translate_service 诚实 degraded（原文直显）
TRANSLATE_API_BASE_URL=
TRANSLATE_API_KEY=
TRANSLATE_MODEL=Atria-Dawn-Preview

# Celery 任务队列
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# 飞书机器人
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_EVENT_ENCRYPT_KEY=
FEISHU_BOT_NAME=优丁建材助手
FEISHU_API_BASE_URL=https://open.feishu.cn/open-apis
FEISHU_DEFAULT_RECEIVER=
FEISHU_DEFAULT_GROUP_ID=
FEISHU_NOTIFICATION_ENABLED=true
FEISHU_WEBHOOK_URL=
FEISHU_OPS_WEBHOOK_URL=

# 安全配置
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_SIZE_MB=20

# 邮件服务
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=

# 物流（Sprint H：demo=沙箱 | kuaidi100=快递100）
LOGISTICS_PROVIDER=demo
KUAIDI100_API_KEY=
KUAIDI100_CUSTOMER=
LOGISTICS_FALLBACK_DEMO=true

# SSL 独立域（Sprint H：mock=开发自动签发 | http=委托 ACME_WEBHOOK_URL）
SSL_PROVIDER=mock
ACME_WEBHOOK_URL=

WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=

# 微信支付 Native v3（生产必填；未配置时开发环境可 mock-pay）
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=
# 推荐：https://你的域名/api/v1/payment/notify/wechat
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_SERIAL=
WECHAT_CERT_CACHE_TTL_SECONDS=3600
# 商户 API 私钥 PEM 文件路径，或直接填 WECHAT_PAY_PRIVATE_KEY（换行用 \n）
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PRIVATE_KEY=
PAYMENT_ALLOW_MOCK=1
PAYMENT_STRICT_VERIFY=0

# 支付宝（预留）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
# 推荐：https://你的域名/api/v1/payment/notify/alipay
# 沙箱：ALIPAY_GATEWAY=https://openapi.alipaydev.com/gateway.do
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 平台落地页线索自动分配（逗号分隔 user id；留空则轮询 sales/admin）
PLATFORM_LEAD_ASSIGNEE_IDS=
EINVOICE_PROVIDER=manual
NUONUO_APP_KEY=
NUONUO_APP_SECRET=
NUONUO_SELLER_TAX_NUM=
NUONUO_API_BASE=https://sdk.nuonuo.com/open/v1/services

# 管理端第三方 OAuth（可选）
# 须与前端管理端实际地址一致（vite 默认 5173）
OAUTH_REDIRECT_URI=http://localhost:5173/login/oauth-callback
# 开发：未配置 QQ/微信等 AppId 时走 dev 模拟回调，便于联调登录页
OAUTH_DEV_BYPASS=true
QQ_APP_ID=
QQ_APP_KEY=
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=
DINGTALK_APP_ID=
DINGTALK_APP_SECRET=

# -----------------------------------------------------------------------------
# 矩阵 admin_users（统一登录校验用，与 seo-backend 矩阵库一致）
# -----------------------------------------------------------------------------
# 方式一：完整 SQLAlchemy URL（推荐生产）
# SEO_MATRIX_DATABASE_URL=mysql+pymysql://user:pass@host:3306/seo_matrix_db?charset=utf8mb4

# 方式二：分项（与 Node SEO_MATRIX_DB_* 指向同一库即可）
SEO_MATRIX_DB_HOST=
SEO_MATRIX_DB_PORT=3306
SEO_MATRIX_DB_USER=
SEO_MATRIX_DB_PASSWORD=
SEO_MATRIX_DB_NAME=

# 本地开发：矩阵 SQLite 文件（未配置 MySQL 时使用）
SEO_MATRIX_SQLITE_PATH=

# -----------------------------------------------------------------------------
# 国际询盘采集（外置爬虫 → Webhook，见 /api/v1/international/webhook）
# -----------------------------------------------------------------------------
# 外置爬虫 POST /api/v1/international/webhook 时必填；未配则验签失败
CRAWL_WEBHOOK_SECRET=

# 每日关键词排名后台线程（默认关；生产按需 true）
RANK_SCHEDULER_ENABLED=false

# RADAR-09 Tavily 外网搜索（技术雷达；未配置则跳过）
TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# 商业飞轮 OS（UBrain / DeerFlow / Accio）
# -----------------------------------------------------------------------------
UBRAIN_AUTO_PIPELINE=1
N8N_WEBHOOK_SECRET=
MEM0_API_URL=
MEM0_API_KEY=
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
DEERFLOW_SIDECAR_URL=
DEERFLOW_SIDECAR_SECRET=
DEERFLOW_QUALITY_RERUN_THRESHOLD=0.45
# DeerFlow 定时：调度器每日 drain；自动入队须 DEERFLOW_SCHEDULE_AUTO_ENQUEUE_ENABLED=true + 套餐 pro/enterprise/flagship
DEERFLOW_SCHEDULER_ENABLED=
DEERFLOW_SCHEDULE_AUTO_ENQUEUE_ENABLED=false
DEERFLOW_SCHEDULE_HOUR=7
DEERFLOW_SCHEDULE_MINUTE=30
DEERFLOW_SCHEDULE_TENANT_IDS=
DEERFLOW_SCHEDULE_MAX_TENANTS=50
DEERFLOW_SCHEDULE_PLAN_CODES=pro,enterprise,flagship
DEERFLOW_SCHEDULE_MONTHLY_LIMIT_PER_TENANT=4
DEERFLOW_RUN_PENDING_LIMIT=10
DEERFLOW_TENANT_CELERY_ENABLED=true
HERMES_OPS_DRAIN_LIMIT=3

# Sprint 4：收录探测（生产 true；本地/CI 建议 false）与 Rank Guard RUM
INCLUSION_PROBE_REAL_ENABLED=false
RUM_LCP_MS=2000
RUM_INP_MS=150
RUM_ERROR_RATE=0.005
# P2 GraphRAG（默认关闭，见 docs/出海计/GraphRAG-占位与Neo4j对接.md）
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
GRAPHRAG_SYNC_ENABLED=0

# -----------------------------------------------------------------------------
# 国密 + 创始人微信唯一（推荐生产）见 docs/安全与国密-源码调试说明.md
# -----------------------------------------------------------------------------
# 创始人绑死（微信号，系统会规范为 wechat_qq979072138）
FOUNDER_WECHAT_BIND_KEY=qq979072138
FOUNDER_WECHAT_OPENID=wechat_qq979072138
FOUNDER_ADMIN_USERNAME=qq979072138
EXPORT_PLATFORM_FOUNDER_ONLY=true
FOUNDER_DEBUG_IPS=
# 仅开发兜底（生产配置 FOUNDER_WECHAT_OPENID 后不必填）
FOUNDER_DEBUG_TOKEN=
GM_SM4_KEY=
GM_SM2_PUBLIC_KEY=
GM_SM2_PRIVATE_KEY=

# AI 国际站接待：生产未配置 LLM 时 /chat/webhook 返回 503（禁止假回复）
# 本地演示可设 AI_CHAT_ALLOW_MOCK=1
# AI_CHAT_ALLOW_MOCK=0

# -----------------------------------------------------------------------------
