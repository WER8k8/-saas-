EGRESS_PROVIDER=manual
EGRESS_JIT_COUNTRY=US
# IPROYAL_API_TOKEN=       # https://iproyal.com 经销商 API
# EGRESS_PROVIDER=iproyal
# IPROYAL_PRODUCT_ID=9
# IPROYAL_PLAN_ID=4
# IPROYAL_LOCATION_ID=51
# IPROYAL_BATCH_SIZE=5
# IPROYAL_POOL_LOW_WATERMARK=2
# ASOCKS_API_KEY=          # https://my.asocks.com/api-help
# ASOCKS_LIST_URL=         # 可选回退：通过链接代理 JSON（limit=1&country=US）
# ASOCKS_LIST_TYPE=res
# ASOCKS_TRAFFIC_LIMIT_GB=10
# ASOCKS_TYPE_ID=
# ASOCKS_PROXY_TYPE_ID=

# -----------------------------------------------------------------------------
# 与 seo-backend 对齐
# -----------------------------------------------------------------------------
# JWT_SECRET_KEY 必须与 seo-backend 的 MAIN_ADMIN_JWT_SECRET 完全一致。
# seo-backend 的 JWT_SECRET 为另一独立密钥，切勿与 JWT_SECRET_KEY 混用。

# -----------------------------------------------------------------------------
# 外部系统集成配置（Hermes 适配器连接）
# -----------------------------------------------------------------------------
# Trade AI Agent - 全域社媒拓客与 WhatsApp 触达中枢
TRADE_AI_AGENT_BASE_URL=http://127.0.0.1:8000
TRADE_AI_AGENT_TIMEOUT=30
TRADE_AI_AGENT_ENABLED=true

# GoodJob CRM - 外贸7步履约、WhatsApp翻译与单证中枢
GOODJOB_CRM_BASE_URL=http://127.0.0.1:5188
GOODJOB_CRM_TIMEOUT=30
GOODJOB_CRM_ENABLED=true

# WhatsApp Plugin - GoodJob CRM 的本地双轨插件
WHATSAPP_PLUGIN_BASE_URL=http://127.0.0.1:3100
WHATSAPP_PLUGIN_UI_URL=http://127.0.0.1:5193
WHATSAPP_PLUGIN_ENABLED=true

# -----------------------------------------------------------------------------
# 本项目能力域（goodjob_crm / trade_ai_agent）已并入优丁，Hermes 原生直驱
# 已删除 GoodJob HTTP 外桥 / uj-bridge 脚本；勿再配置 GOODJOB_BASE_URL。
# 真相与业务写路径 = 优丁 PG + native_fulfillment / native_acquisition。
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# 附属统一登录（§9.3 · 短时授权票据 annex_ticket，可选 iframe 诊断入口）
# 票据密钥独立于主 JWT 更佳；缺省回落 JWT_SECRET_KEY。
# 若仍启用嵌入诊断页：ANNEX 侧共享密钥见 ANNEX 相关配置（非业务调度桥）。
# -----------------------------------------------------------------------------
# ANNEX_TICKET_SECRET=

# -----------------------------------------------------------------------------
# RLS 试点（tenant-isolation-rls-pilot-design · 批次 1 安全收口）
# 默认关闭。开启前置条件：① 试点表已有 tenant_id 列且历史数据已回填；
# ② 在真实 PostgreSQL 中执行 alembic upgrade head 创建策略；
# ③ 完成 BaseRepository 集成测试（见设计文档「未验证点」）。
# -----------------------------------------------------------------------------
# RLS_PILOT_ENABLED=false
# RLS_PILOT_TABLES=   # 逗号分隔，如 "mcp_servers,plugins"


# -----------------------------------------------------------------------------
# 平台凭证（全平台获客链路：填哪儿 / 去哪儿申请）
# 机器可读清单：GET /api/v1/seo-matrix/platform-credential-guide
#   该接口会回「每个平台要哪些字段 + 申请入口 URL + 当前 env 是否已配（只回布尔）」
# 三处落点，优先级 configs < cookie < token_data：
#   1) 平台账号（POST/PUT /api/v1/seo-matrix/platform-accounts）→ 单店专属凭证走这里
#   2) 本文件（backend/.env）→ 全局通道级密钥走这里
#   3) platform_configs 键值表 → 上面两者都会写进这张表做兜底
# 缺凭证时系统如实返回 PLATFORM_NOT_CONFIGURED，不会假装已发布。
# -----------------------------------------------------------------------------
# —— 谷歌 Search Console（获客排名真值回收）——
# 申请：console.cloud.google.com 建项目 → 启用 Search Console API
#       → 创建服务账号 → 下载 JSON → 把该服务账号邮箱加为 GSC 资源的「拥有者/用户」
# 注意：GSC 数据接口不接受纯 API Key，只配 GSC_API_KEY 查不到真值。
# GSC_SERVICE_ACCOUNT_JSON=            # 内联 JSON，或密钥文件绝对路径（文件勿入仓库）
# GSC_API_KEY=                         # 仅部分公开接口可用，不用于查数据
# GSC_ALLOW_MOCK=false                 # 生产保持 false；开了才允许 dev mock

# —— 百度站长（收录推送）——
# 申请：ziyuan.baidu.com → 站点管理 → 添加并验证站点 → 主动推送取 token
# BAIDU_SITE_TOKEN=

# —— 海外 B2B（Alibaba.com / Made-in-China.com / Global Sources）——
# 三家都要商家侧付费账号 + 接口权限；无权限时链路停在 PLATFORM_NOT_CONFIGURED。
# Alibaba：i.alibaba.com（卖家后台）/ open.alibaba.com（开放平台建应用取 access_token）
# ALIBABA_MEMBER_ID=
# ALIBABA_ACCESS_TOKEN=                # 合规路径（推荐）
# ALIBABA_SESSION_COOKIE=              # 兜底路径，有风控与封号风险
# MIC：seller.made-in-china.com（供应商后台→接口授权，或找客户经理开通）
# MIC_ACCESS_TOKEN=
# GlobalSources：无公开自助 API，需联系客户经理（CSM）开通上传接口
# GS_API_KEY=

# —— 微信公众号 ——
# 申请：mp.weixin.qq.com → 设置与开发 → 基本配置（appid/appsecret）
# 必须把服务器出口 IP 加进「IP 白名单」，否则报 40164

# —— 国内图文平台（知乎 / 百家号 / 头条号 / 小红书 / 微博）——
# 无开放 API，用登录 Cookie：浏览器登录后 F12 → Network → 任一请求的 Cookie 整条
# 填到平台账号的 cookie 字段（会随登录过期，需定期更新）

# —— 海外社媒（X / TikTok / LinkedIn / Facebook / Instagram / Reddit / Medium…）——
# 走 AiToEarn 通道，OAuth 由通道侧管理，系统里只放一个通道 key
# AITOEARN_API_KEY=

